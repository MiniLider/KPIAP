<Window x:Class="WpfApp1.Avia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авиабронирование" Height="526.168" Width="689.72" Background="#f0f0f0">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Авиабронирование" FontSize="24" FontWeight="Bold" Margin="0,10,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Город вылета:" FontSize="16" Margin="0,10,0,5"/>
            <Grid>
                <TextBox x:Name="DepartureCityTextBox" Width="400" Height="30" Margin="143,0,99,0" />
            </Grid>

            <TextBlock Text="Город назначения:" FontSize="16" Margin="0,10,0,5"/>
            <Grid>
                <TextBox x:Name="DestinationCityTextBox" Width="400" Height="30" Margin="162,0,80,0" />
            </Grid>

            <TextBlock Text="Дата вылета:" FontSize="16" Margin="0,10,0,5"/>
            <DatePicker x:Name="DepartureDatePicker" Width="400" Height="30" />

            <TextBlock Text="Дата возвращения:" FontSize="16" Margin="0,10,0,5"/>
            <DatePicker x:Name="ReturnDatePicker" Width="400" Height="30" />

            <TextBlock Text="Класс перелета:" FontSize="16" Margin="0,10,0,5"/>
            <ComboBox x:Name="FlightClassComboBox" Width="400" Height="30">
                <ComboBoxItem Content="Эконом" />
                <ComboBoxItem Content="Бизнес" />
                <ComboBoxItem Content="Первый класс" />
            </ComboBox>

            <Button x:Name="BookFlight" Content="Забронировать" Width="400" Height="30" Margin="0,20,0,0" Click="BookFlight_Click"/>
        </StackPanel>
        <Button Content="Назад" Click="Back_Click" HorizontalAlignment="Left" Margin="10,425,0,0" VerticalAlignment="Top" Width="75" Height="20"/>
    </Grid>
</Window>