<Window x:Class="WpfApp1.Zaiti"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="400" Width="500">
    <Grid Background="#FFA49E9E">
        <Label Content="Имя:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
        <TextBox Name="NameTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,10,0,0"/>

        <Label Content="Email:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,50,0,0"/>
        <TextBox Name="EmailTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,50,0,0"/>

        <Label Content="Ваши брони:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,90,0,0"/>
        <ListBox Name="BookingsListBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,120,0,0" Width="460" Height="150"/>

        <Button Content="Сохранить" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="390,292,0,0" Click="Save_Click" Height="33" Width="80"/>
        <Button Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,292,421,0" Click="Back_Click" RenderTransformOrigin="-4.658,1.273" Height="33" Width="61"/>
    </Grid>
</Window>
