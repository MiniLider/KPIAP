<Window x:Class="WpfApp1.OtelPrilet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прилет" Height="400" Width="600">
    <Grid Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Отели" FontSize="20" Margin="0,0,0,10"/>
            <ListBox x:Name="HotelsListBox" SelectionChanged="HotelsListBox_SelectionChanged" Height="300"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Место пребывания" FontSize="20" Margin="0,0,0,10"/>
            <TextBox x:Name="CityTextBox" Width="200" Margin="0,0,0,10"/>
            <Button Content="Найти" Click="FindButton_Click" Width="200" Margin="0,0,0,10"/>

            <TextBlock Text="Информация о отеле" FontSize="16" Margin="0,10,0,5"/>
            <TextBox x:Name="HotelInfoTextBox" Width="200" Height="100" IsReadOnly="True" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="Bback0" Content="Назад" Click="Bback0_Click" Grid.Column="1" HorizontalAlignment="Left" Height="37" Margin="307,310,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>