<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Форма входа" Height="368.608" Width="402.671" Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
        <StackPanel Height="231" Margin="-22,0,-15,0">
            <TextBlock Text="Login form" TextAlignment="Center" FontWeight="Bold" Height="40"/>
            <DockPanel LastChildFill="True">
                <TextBlock Text="Login:"/>
                <TextBox x:Name="LoginTextBox" TextChanged="LoginTextBox_TextChanged" Height="26"/>
            </DockPanel>
            <DockPanel LastChildFill="True">
                <TextBlock Text="Password:"/>
                <PasswordBox x:Name="PassBox" Height="26"/>
            </DockPanel>
            <TextBlock x:Name="MessageBlock" Foreground="Red" Height="30"/>
            <Button Content="Log in" x:Name="LoginButton" Click="OpenMainWindow_Click"
                    IsDefault="True" Height="35                     " VerticalContentAlignment="Center" BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Background="{DynamicResource {x:Static SystemColors.InactiveBorderBrushKey}}" Margin="61,0,50,0"/>
            <Button Content="Button" Margin="0,0,370,0" Height="27"/>
            <Button x:Name="Back" Content="Назад" Margin="0,0,225,0" Click="Back_Click"/>

        </StackPanel>
    </Border>
</Window>