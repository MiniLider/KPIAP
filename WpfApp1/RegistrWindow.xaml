<Window x:Class="WpfApp1.RegistrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Форма регистрации" Height="400" Width="400">
    <Grid Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
        <Label Content="Имя пользователя:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,107,0,0"/>
        <TextBox Name="UsernameTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,107,0,0" Width="186" Height="26" TextChanged="UsernameTextBox_TextChanged"/>

        <Label Content="Электронная почта:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,155,0,0"/>
        <TextBox Name="EmailTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,155,0,0" Width="186" Height="26"/>

        <Label Content="Пароль:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="63,198,0,0"/>
        <PasswordBox Name="PasswordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="181,198,0,0" Width="155" Height="27"/>

        <Label Content="Подтверждение пароля:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,241,0,0"/>
        <PasswordBox Name="ConfirmPasswordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="181,241,0,0" Width="155" Height="26"/>

        <Button Content="Зарегистрироваться" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,292,0,0" Width="150" Click="RegisterButton_Click"/>

        <TextBlock Name="ResultTextBlock" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,220,0,0" Foreground="Red"/>
        <Label Content="РЕГИСТРАЦИЯ" HorizontalAlignment="Left" Margin="103,29,0,0" VerticalAlignment="Top" Height="35" Width="207" FontSize="18" FontFamily="Yu Gothic Medium"/>
        <Button x:Name="Back" Content="Назад" HorizontalAlignment="Left" Margin="20,297,0,0" VerticalAlignment="Top" Width="75" Click="Back_Click"/>
    </Grid>
</Window>