<Window x:Class="WpfApp1.Zadat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обратная связь" Height="437.895" Width="598.816">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Обратная связь с администрацией" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10" />

        <!-- Имя -->
        <TextBlock Text="Ваше имя:" FontWeight="Bold" Margin="0,0,0,5" />
        <TextBox Name="NameTextBox" Margin="0,0,0,10" Height="30" />

        <!-- Email -->
        <TextBlock Text="Ваш Email:" FontWeight="Bold" Margin="0,0,0,5" />
        <TextBox Name="EmailTextBox" Margin="0,0,0,10" Height="30" />

        <!-- Вопрос -->
        <TextBlock Text="Ваш вопрос:" FontWeight="Bold" Margin="0,0,0,5" />
        <TextBox Name="QuestionTextBox" Height="150" 
                  TextWrapping="Wrap" AcceptsReturn="True" 
                  Margin="0,0,0,10" />

        <!-- Кнопка отправки -->
        <Button Name="SubmitButton" Content="Отправить" 
                Width="100" Height="30" 
                HorizontalAlignment="Right" 
                Click="SubmitButton_Click" />
        <Button x:Name="Bback1" Content="Назад" Click="Bback1_Click" HorizontalAlignment="Left" Margin="10,197,0,0" Grid.Row="2" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>