<Window x:Class="WpfApp1.Rasprod"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Распродажа туров" Height="647.664" Width="941.589">
    <Grid>
        <StackPanel Margin="0,0,0,31">
            <!-- Заголовок -->
            <TextBlock 
                       FontSize="36" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="10" ><Run Text="Распродажа туров"/></TextBlock>
            <DataGrid AutoGenerateColumns="False" 
                       ItemsSource="{Binding TourList}" 
                       Margin="10" 
                       Height="444">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="*"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Цена за человека" Binding="{Binding Price}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Картинка скидок -->
            <Image Source="discount_image.png" 
                   Height="200" 
                   HorizontalAlignment="Center" 
                   Margin="10"/>

            <!-- Таблица с информацией о турах -->
        </StackPanel>
        <Button x:Name="Back" Content="Назад" Click="Back_Click" HorizontalAlignment="Left" Height="33" Margin="27,553,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>