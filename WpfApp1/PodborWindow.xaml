<Window x:Class="WpfApp1.PodborWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подбор тура" Height="468.309" Width="773.955">
    <Grid Margin="1,-2,-1,-2" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.128"/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="122"/>
            <RowDefinition Height="Auto" MinHeight="40"/>
            <RowDefinition Height="Auto" MinHeight="102"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Квадрат с городом -->
        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="408,78,29,24" Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Grid.RowSpan="2">
            <StackPanel>
                <TextBlock Text="Город вылета" FontWeight="Bold" />
                <ComboBox x:Name="CityComboBox" />
            </StackPanel>
        </Border>

        <!-- Квадрат с страной -->
        <Border Grid.Row="1" BorderBrush="#FFE8DADA" BorderThickness="1" Padding="10" Margin="60,78,381,24" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Grid.RowSpan="2">
            <StackPanel>
                <TextBlock Text="Страна" FontWeight="Bold" />
                <ComboBox x:Name="CountryComboBox" SelectionChanged="CountryComboBox_SelectionChanged">
                    <ComboBoxItem Content="Россия" />
                    <ComboBoxItem Content="Беларусь" />
                    <ComboBoxItem Content="Индия" />
                    <ComboBoxItem Content="Китай" />
                    <ComboBoxItem Content="Италия" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Квадрат для ввода количества людей -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="457,34,29,1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Количество туристов" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button Content="-" Click="DecreaseButton_Click" Width="30"/>
                <TextBox x:Name="PeopleCountTextBox" Width="50" Text="1" HorizontalAlignment="Center" Margin="5,0"/>
                <Button Content="+" Click="IncreaseButton_Click" Width="30"/>
            </StackPanel>
        </Border>

        <!-- Квадрат с календарем -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="60,10,557,1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel>
                <TextBlock Text="Дата вылета" FontWeight="Bold" />
                <DatePicker x:Name="DepartureDatePicker" />
            </StackPanel>
        </Border>
        <Button x:Name="Poisk" Content="Найти" Click="Poisk_Click" HorizontalAlignment="Left" Margin="350,67,0,0" Grid.Row="4" VerticalAlignment="Top" Width="121" Height="55" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="223,25,328,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Ночей" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button Content="-" Click="DecreaseButton1_Click" Width="30"/>
                <TextBox x:Name="NightTextBox" Width="50" Text="1" HorizontalAlignment="Center" Margin="5,0"/>
                <Button Content="+" Click="IncreaseButton1_Click" Width="30"/>
            </StackPanel>
        </Border>
        <Button x:Name="Bback" Content="Назад" Click="Bback_Click" HorizontalAlignment="Left" Margin="10,119,0,0" Grid.Row="4" VerticalAlignment="Top" Width="85" Height="31"/>

    </Grid>
</Window>